# Copie este arquivo para .env e preencha os valores
# cp .env.example .env

# Senha do banco de dados PostgreSQL (desenvolvimento)
HARR_DATABASE_PASSWORD=sua_senha_aqui

# Chave da API do TMDB — obtenha em https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_aqui

# Master key do Rails — valor em config/master.key (necessário em produção)
RAILS_MASTER_KEY=sua_master_key_aqui
