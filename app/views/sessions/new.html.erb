<% content_for :title, "Login | HARR" %><main class="container page-content" id="conteudo"><div class="auth-card"><p class="eyebrow">BEM-VINDO DE VOLTA</p><h1>Entrar</h1><div class="form-card"><%= form_with url: session_path, method: :post, local: true, class: "stacked" do |f| %><%= f.label :username, "Usuário" %><%= f.text_field :username, required: true %><%= f.label :password, "Senha" %><%= f.password_field :password, required: true %><%= f.submit "Entrar", class: "button" %><% end %></div><p style="margin-top:18px">Ainda não tem conta? <%= link_to "Cadastre-se", new_registration_path, class: "text-link" %>.</p></div></main>
