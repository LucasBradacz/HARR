<div class="page">
  <h1>Buscar filmes</h1>

  <%= form_with url: movies_path, method: :get, local: true, html: { class: "search-form" } do %>
    <%= text_field_tag :q, params[:q], placeholder: "Digite o nome do filme..." %>
    <%= submit_tag "Buscar" %>
  <% end %>

  <% if params[:q].present? %>
    <% if @results.empty? %>
      <p>Nenhum filme encontrado para "<%= params[:q] %>".</p>
    <% else %>
      <div class="poster-grid">
        <% @results.each do |result| %>
          <%= link_to movie_path(result["id"]), class: "poster-card" do %>
            <% if result["poster_path"].present? %>
              <%= image_tag "https://image.tmdb.org/t/p/w300#{result['poster_path']}", alt: result["title"] %>
            <% else %>
              <div style="aspect-ratio:2/3;display:flex;align-items:center;justify-content:center;color:var(--text-muted);font-size:0.8rem;">
                Sem pôster
              </div>
            <% end %>
            <div class="poster-info">
              <div class="poster-title"><%= result["title"] %></div>
              <div class="poster-year"><%= result["release_date"].to_s.first(4) %></div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p style="color:var(--text-muted);">Digite o nome de um filme acima para começar a buscar.</p>
  <% end %>
</div>