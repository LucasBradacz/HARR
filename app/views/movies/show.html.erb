<% content_for :title, "#{@movie.title} | HARR" %>

<%# Banner hero — pôster grande com fundo desfocado %>
<div class="film-hero">
  <% if @movie.poster_url.present? %>
    <div class="film-hero-backdrop" style="background-image: url('<%= @movie.poster_url %>')"></div>
  <% end %>
  <div class="container film-hero-inner">
    <% if @movie.poster_url.present? %>
      <%= image_tag @movie.poster_url, class: "film-hero-poster", alt: "Cartaz de #{@movie.title}" %>
    <% end %>
    <div class="film-hero-info">
      <h1 class="film-title"><%= @movie.title %> <span class="film-year"><%= @movie.release_year %></span></h1>
      <div class="genre-list">
        <% @movie.genres.each do |genre| %>
          <span class="genre"><%= genre.name %></span>
        <% end %>
      </div>
      <p class="film-synopsis"><%= @movie.synopsis.presence || "Sinopse não disponível." %></p>
      <% if logged_in? %>
        <div class="film-actions">
          <% if current_user.watchlist_items.exists?(movie: @movie) %>
            <%= button_to "✓ Na watchlist", movie_watchlist_item_path(@movie), method: :delete, class: "button secondary film-action-btn" %>
          <% else %>
            <%= button_to "+ Watchlist", movie_watchlist_item_path(@movie), method: :post, class: "button film-action-btn" %>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<main class="container page-content" id="conteudo">
  <%= link_to "← Voltar para filmes", movies_path, class: "back-link" %>

  <%# Formulário unificado: nota + review opcional. Sem texto = só diário via after_create %>
  <% if logged_in? %>
    <section class="section">
      <div class="section-heading">
        <h2>Registrar</h2>
        <span>SUA EXPERIÊNCIA COM ESTE FILME</span>
      </div>
      <div class="form-card">
        <%= form_with model: Review.new, url: movie_reviews_path(@movie), local: true, class: "stacked" do |f| %>
          <div class="log-form-grid">
            <div class="field">
              <%= f.label :rating, "Nota" %>
              <div class="star-picker">
                <% (5).downto(1) do |n| %>
                  <%= f.radio_button :rating, n, class: "star-pick-radio" %>
                  <label for="<%= "review_rating_#{n}" %>" class="star-pick-label" title="<%= n %> estrela<%= n == 1 ? '' : 's' %>">★</label>
                <% end %>
              </div>
            </div>
            <div class="field">
              <%= f.label :watched_on, "Data" %>
              <%= f.date_field :watched_on, value: Date.current, class: "input" %>
            </div>
          </div>
          <%= f.label :body, "Review (opcional)" %>
          <%= f.text_area :body, placeholder: "O que você achou? Deixe em branco para registrar apenas a nota no diário.", rows: 4 %>
          <label class="spoiler-label">
            <%= f.check_box :contains_spoilers %>
            Contém spoilers
          </label>
          <%= f.submit "Publicar", class: "button" %>
        <% end %>
      </div>
    </section>
  <% end %>

  <%# Reviews da comunidade %>
  <section class="section">
    <div class="section-heading">
      <h2>Reviews</h2>
      <% reviews_count = @movie.reviews.size %>
      <span><%= reviews_count %> CRÍTICA<%= reviews_count == 1 ? "" : "S" %></span>
    </div>

    <% if @movie.reviews.any? %>
      <% @movie.reviews.includes(:user).order(created_at: :desc).each do |review| %>
        <article class="film-review">
          <div class="film-review-header">
            <% if review.user.avatar_url.present? %>
              <%= image_tag review.user.avatar_url, class: "film-review-avatar", alt: review.user.username %>
            <% else %>
              <div class="film-review-avatar film-review-avatar--initial"><%= review.user.username.first.upcase %></div>
            <% end %>
            <div>
              <div class="film-review-author">
                <%= link_to review.user.username, user_path(review.user.username) %>
              </div>
              <div class="film-review-stars stars"><%= "★" * review.rating.to_i %><span class="star-empty"><%= "★" * (5 - review.rating.to_i) %></span></div>
            </div>
            <time class="film-review-date" datetime="<%= review.created_at.iso8601 %>">
              <%= review.created_at.strftime("%d/%m/%Y") %>
            </time>
            <% if logged_in? && review.user == current_user %>
              <div class="review-actions film-review-actions">
                <%= link_to "Editar", edit_review_path(review) %>
                <%= button_to "Excluir", review_path(review), method: :delete, class: "danger", form_class: "inline-form", data: { turbo_confirm: "Tem certeza que quer excluir esta review?" } %>
              </div>
            <% end %>
          </div>
          <% if review.contains_spoilers %>
            <p class="spoiler-warning eyebrow">⚠ Contém spoilers</p>
          <% end %>
          <% if review.body.present? %>
            <%= render "reviews/body", body: review.body %>
          <% end %>
        </article>
      <% end %>
    <% else %>
      <p class="empty-state">Nenhuma review ainda. Seja o primeiro!</p>
    <% end %>
  </section>
</main>
