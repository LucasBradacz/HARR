<h1><%= @user.username %></h1>
<p><%= @user.bio %></p>

<% if logged_in? && current_user != @user %>
  <% if current_user.following.include?(@user) %>
    <%= button_to "Deixar de seguir", unfollow_path(@user.id), method: :delete %>
  <% else %>
    <%= button_to "Seguir", follow_path(@user.id), method: :post %>
  <% end %>
<% end %>

<h2>Reviews</h2>
<ul>
  <% @reviews.each do |review| %>
    <li><%= link_to review.movie.title, movie_path(review.movie) %> — <%= review.rating %>/5</li>
  <% end %>
</ul>

<h2>Diário</h2>
<ul>
  <% @diary_entries.each do |entry| %>
    <li><%= entry.watched_on %> — <%= link_to entry.movie.title, movie_path(entry.movie) %> — <%= entry.rating %>/5</li>
  <% end %>
</ul>