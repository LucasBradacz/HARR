<% content_for :title, "Perfil | HARR" %>
<% content_for :rubens_page, "perfil" %>
<main class="container page-content" id="conteudo">
            <!-- DETALHES PIRATAS: pergaminho e bússola decorativos, definidos no CSS. -->
            <div class="page-heading">
                <p class="eyebrow">PERFIL</p>
                <h1>Meu perfil</h1>
                <p>Seus filmes, suas listas e suas avaliações.</p>
                <span aria-hidden="true" class="pirate-seal">⚓</span>
            </div>
            <section class="profile-header">
                <div aria-label="Avatar de Monique" class="profile-avatar captain-avatar" data-profile-avatar="">
                    M
                    <span aria-hidden="true">⚓</span>
                </div>
                <div class="profile-bio">
                    <p class="eyebrow">MEMBRO DO HARR</p>
                    <h2 data-profile-name="">Monique</h2>
                    <p class="profile-handle">@monique</p>
                    <p data-profile-bio="">Gosto de descobrir novos filmes e revisitar meus clássicos favoritos.</p>
                    <span class="captain-rank">MEMBRO · HARR</span>
                </div>
                <button class="button secondary" id="editar-perfil" type="button">
                    <svg aria-hidden="true" class="ui-icon" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                        <path d="m15 5 4 4M4 20l4-1L20 7a3 3 0 0 0-4-4L4 15Z">
                        </path>
                    </svg>
                    Editar perfil
                </button>
            </section>
            <div class="profile-stats">
                <div>
                    <strong>42</strong>
                    <span>Filmes</span>
                </div>
                <div>
                    <strong>12</strong>
                    <span>Neste ano</span>
                </div>
                <div>
                    <strong>2</strong>
                    <span>Listas</span>
                </div>
            </div>
            <!-- QUATRO FILMES FAVORITOS -->
            <section class="section" id="favoritos">
                <div class="section-heading">
                    <h2>Favoritos</h2>
                    <span>SUA COLEÇÃO LOCAL</span>
                </div>
                <div class="movies-grid">
                    <!-- FILME: Interestelar — edite cartaz, título, ano e sinopse neste bloco. -->
                    <article class="movie-card">
                        <button aria-label="Ver informações de Interestelar" class="movie-open" data-filme="interstellar" type="button">
                            <span class="poster-wrapper">
                                <img alt="Cartaz de Interestelar" height="750" loading="lazy" src="<%= asset_path("rubens/interstellar.jpg") %>" width="500"/>
                                <span class="poster-hint">Abrir ficha +</span>
                            </span>
                            <span class="movie-title">Interestelar</span>
                            <span class="movie-meta">2014 · Ficção científica</span>
                        </button>
                    </article>
                    <!-- FILME: Whiplash — edite cartaz, título, ano e sinopse neste bloco. -->
                    <article class="movie-card">
                        <button aria-label="Ver informações de Whiplash" class="movie-open" data-filme="whiplash" type="button">
                            <span class="poster-wrapper">
                                <img alt="Cartaz de Whiplash" height="750" loading="lazy" src="<%= asset_path("rubens/whiplash.jpg") %>" width="500"/>
                                <span class="poster-hint">Abrir ficha +</span>
                            </span>
                            <span class="movie-title">Whiplash</span>
                            <span class="movie-meta">2014 · Drama</span>
                        </button>
                    </article>
                    <!-- FILME: A Viagem de Chihiro — edite cartaz, título, ano e sinopse neste bloco. -->
                    <article class="movie-card">
                        <button aria-label="Ver informações de A Viagem de Chihiro" class="movie-open" data-filme="spirited" type="button">
                            <span class="poster-wrapper">
                                <img alt="Cartaz de A Viagem de Chihiro" height="750" loading="lazy" src="<%= asset_path("rubens/spirited.jpg") %>" width="500"/>
                                <span class="poster-hint">Abrir ficha +</span>
                            </span>
                            <span class="movie-title">A Viagem de Chihiro</span>
                            <span class="movie-meta">2001 · Animação</span>
                        </button>
                    </article>
                    <!-- FILME: Parasita — edite cartaz, título, ano e sinopse neste bloco. -->
                    <article class="movie-card">
                        <button aria-label="Ver informações de Parasita" class="movie-open" data-filme="parasite" type="button">
                            <span class="poster-wrapper">
                                <img alt="Cartaz de Parasita" height="750" loading="lazy" src="<%= asset_path("rubens/parasite.jpg") %>" width="500"/>
                                <span class="poster-hint">Abrir ficha +</span>
                            </span>
                            <span class="movie-title">Parasita</span>
                            <span class="movie-meta">2019 · Suspense</span>
                        </button>
                    </article>
                </div>
            </section>
            <!-- COMENTÁRIOS: o JavaScript reúne todos os comentários locais dos filmes. -->
            <section class="section profile-comments" id="meus-comentarios">
                <div class="section-heading">
                    <h2>Meus comentários</h2>
                    <span id="total-comentarios" role="status">0 comentários</span>
                </div>
                <p class="muted small">Comentários publicados por você neste navegador, agrupados por filme.</p>
                <div id="lista-comentarios">
                </div>
            </section>
            <p class="demo-note">Seu perfil e suas listas ficam salvos neste navegador.</p>
        </main>
