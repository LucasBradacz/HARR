<section class="home-reviews">
                <div class="section-heading">
                    <h2>Avaliações populares</h2>
                    <a href="<%= movies_path %>">Ver filmes →</a>
                </div>
                <p class="small muted">Avaliações e curtidas demonstrativas.</p>
                <article class="community-review">
                    <button aria-label="Abrir Interestelar" class="review-film" data-filme="interstellar" type="button">
                        <img alt="Cartaz de Interestelar" height="114" src="<%= asset_path("rubens/interstellar.jpg") %>" width="76"/>
                    </button>
                    <div class="review-content">
                        <h3>
                            <button class="title-button" data-filme="interstellar">
                                Interestelar
                            </button>
                            <span>2014</span>
                        </h3>
                        <div class="review-user">
                            <span class="mini-avatar">M</span>
                            <strong>Marina</strong>
                            <span aria-label="5 de 5 estrelas" class="review-stars">★★★★★</span>
                            <span aria-label="Filme favorito" class="review-heart">♥</span>
                        </div>
                        <p class="review-text">Tem filmes que terminam nos créditos. Esse continua na sua cabeça por dias.</p>
                        <button aria-pressed="false" class="like-review" data-count="1248" type="button">
                            ♥ Gostei da avaliação
                            <span>1.248 curtidas</span>
                        </button>
                    </div>
                </article>
