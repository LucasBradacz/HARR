<section aria-label="Pesquisa e filtros" class="catalog-tools">
                <label class="search-label" for="pesquisa">
                    Encontre seu próximo filme
                </label>
                <div class="search-box">
                    <span aria-hidden="true">
                        <svg aria-hidden="true" class="ui-icon" fill="none" focusable="false" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" viewBox="0 0 24 24">
                            <circle cx="10.5" cy="10.5" r="6.5">
                            </circle>
                            <path d="m16 16 5 5">
                            </path>
                        </svg>
                    </span>
                    <input id="pesquisa" placeholder="Busque por título, diretor ou palavra-chave" type="search"/>
                    <button class="button" id="buscar-filmes" type="button">
                        Pesquisar
                    </button>
                </div>
                <div class="filter-grid">
                    <label for="filtro-ano">
                        Ano
                        <select id="filtro-ano">
                            <option value="">Todos os anos</option>
                            <option value="2024">2024</option>
                            <option value="2019">2019</option>
                            <option value="2014">2014</option>
                            <option value="2010">2010</option>
                            <option value="2008">2008</option>
                            <option value="2001">2001</option>
                            <option value="1999">1999</option>
                            <option value="1972">1972</option>
                        </select>
                    </label>
                    <label for="filtro-avaliacao">
                        Avaliação
                        <select id="filtro-avaliacao">
                            <option value="">Todas as notas</option>
                            <option value="5">5 estrelas</option>
                            <option value="4">4 estrelas ou mais</option>
                            <option value="3">3 estrelas ou mais</option>
                        </select>
                    </label>
                    <label for="filtro-popular">
                        Popularidade
                        <select id="filtro-popular">
                            <option value="">Todos os filmes</option>
                            <option value="Mais populares">Mais populares</option>
                            <option value="Menos populares">Menos populares</option>
                        </select>
                    </label>
                    <label for="filtro-genero">
                        Gênero
                        <select id="filtro-genero">
                            <option value="">Todos os gêneros</option>
                            <option value="Ação">Ação</option>
                            <option value="Animação">Animação</option>
                            <option value="Aventura">Aventura</option>
                            <option value="Comédia">Comédia</option>
                            <option value="Crime">Crime</option>
                            <option value="Drama">Drama</option>
                            <option value="Fantasia">Fantasia</option>
                            <option value="Ficção científica">Ficção científica</option>
                            <option value="Música">Música</option>
                            <option value="Suspense">Suspense</option>
                        </select>
                    </label>
                </div>
                <p class="prototype-note">Combine os filtros para refinar o catálogo.</p>
                <button class="button secondary" id="limpar-filtros" type="button">
                    Limpar filtros
                </button>
            </section>
