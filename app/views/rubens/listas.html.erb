<% content_for :title, "Listas | HARR" %>
<% content_for :rubens_page, "listas" %>
<main class="container page-content" id="conteudo">
            <!-- DETALHES PIRATAS: pergaminho e bússola decorativos, definidos no CSS. -->
            <div class="page-heading">
                <p class="eyebrow">SUAS COLEÇÕES</p>
                <h1>Minhas listas</h1>
                <p>Suas coleções e os filmes que você quer assistir.</p>
                <span aria-hidden="true" class="pirate-seal">⚓</span>
            </div>
            <section class="section" id="listas">
                <div class="section-heading">
                    <h2>Minhas listas</h2>
                    <span>LISTAS PARA A SUA PRÓXIMA SESSÃO</span>
                </div>
                <div class="list-grid">
                    <a class="list-card" href="<%= (logged_in? ? user_path(current_user.username) : new_session_path) %>#favoritos">
                        <div class="mini-posters">
                            <img alt="Interestelar" src="<%= asset_path("rubens/interstellar.jpg") %>"/>
                            <img alt="A Viagem de Chihiro" src="<%= asset_path("rubens/spirited.jpg") %>"/>
                            <img alt="Whiplash" src="<%= asset_path("rubens/whiplash.jpg") %>"/>
                        </div>
                        <div>
                            <span class="eyebrow">FILMES FAVORITOS</span>
                            <h3>Meus filmes favoritos</h3>
                            <p>
                                4 filmes · por Monique
                                <span>↗</span>
                            </p>
                        </div>
                    </a>
                    <a class="list-card" href="<%= watchlist_path %>#watchlist">
                        <div class="mini-posters">
                            <img alt="Duna: Parte Dois" src="<%= asset_path("rubens/dune.jpg") %>"/>
                            <img alt="O Grande Hotel Budapeste" src="<%= asset_path("rubens/grand.jpg") %>"/>
                        </div>
                        <div>
                            <span class="eyebrow">QUERO ASSISTIR</span>
                            <h3>Ainda há muito para descobrir</h3>
                            <p>
                                2 filmes · quero assistir
                                <span>↗</span>
                            </p>
                        </div>
                    </a>
                </div>
            </section>
            <!-- LISTA DE DESEJOS -->
            <section class="section" id="watchlist">
                <div class="section-heading">
                    <h2>Quero assistir</h2>
                    <span>QUERO ASSISTIR</span>
                </div>
                <div class="movies-grid">
                    <!-- FILME: Duna: Parte Dois — edite cartaz, título, ano e sinopse neste bloco. -->
                    <article class="movie-card">
                        <button aria-label="Ver informações de Duna: Parte Dois" class="movie-open" data-filme="dune" type="button">
                            <span class="poster-wrapper">
                                <img alt="Cartaz de Duna: Parte Dois" height="750" loading="lazy" src="<%= asset_path("rubens/dune.jpg") %>" width="500"/>
                                <span class="poster-hint">Abrir ficha +</span>
                            </span>
                            <span class="movie-title">Duna: Parte Dois</span>
                            <span class="movie-meta">2024 · Ficção científica</span>
                        </button>
                    </article>
                    <!-- FILME: O Grande Hotel Budapeste — edite cartaz, título, ano e sinopse neste bloco. -->
                    <article class="movie-card">
                        <button aria-label="Ver informações de O Grande Hotel Budapeste" class="movie-open" data-filme="grand" type="button">
                            <span class="poster-wrapper">
                                <img alt="Cartaz de O Grande Hotel Budapeste" height="750" loading="lazy" src="<%= asset_path("rubens/grand.jpg") %>" width="500"/>
                                <span class="poster-hint">Abrir ficha +</span>
                            </span>
                            <span class="movie-title">O Grande Hotel Budapeste</span>
                            <span class="movie-meta">2014 · Comédia</span>
                        </button>
                    </article>
                </div>
            </section>
        </main>
