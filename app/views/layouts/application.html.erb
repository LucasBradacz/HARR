<!DOCTYPE html>
<html>
<head>
  <title><%= content_for(:title) || "HARR" %></title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="application-name" content="Harr">
  <meta name="mobile-web-app-capable" content="yes">
  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <%= yield :head %>

  <link rel="icon" href="/icon.png" type="image/png">
  <link rel="icon" href="/icon.svg" type="image/svg+xml">
  <link rel="apple-touch-icon" href="/icon.png">

  <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>

<body>
<div class="navbar">
  <%= link_to "HARR", root_path, class: "brand" %>
  <nav>
    <% if logged_in? %>
      <%= link_to current_user.username, user_path(current_user.username) %>
      <%= link_to "Watchlist", watchlist_path %>
      <%= button_to "Sair", logout_path, method: :delete %>
    <% else %>
      <%= link_to "Login", new_session_path %>
      <%= link_to "Cadastrar", new_registration_path, class: "btn-primary" %>
    <% end %>
  </nav>
</div>

<% flash.each do |type, msg| %>
  <div class="flash"><%= msg %></div>
<% end %>

<%= yield %>
</body>
</html>