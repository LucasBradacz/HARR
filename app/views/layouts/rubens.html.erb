<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= content_for(:title) || "HARR" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "rubens/01_base",
          "rubens/02_header",
          "rubens/03_cards",
          "rubens/04_reviews",
          "rubens/05_profile",
          "rubens/06_responsive",
          "rubens/07_navigation",
          "rubens/08_pirate_theme",
          "rubens/09_background",
          "rubens/10_filters",
          "rubens/11_top_ten",
          "rubens/12_movie_dialog",
          "rubens/13_interactions",
          "rubens/14_home",
          "rubens/15_search",
          "rubens/16_profile_editor",
          "rubens/17_ui",
          "rubens/18_rails", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <% assets = %w[bandeira.svg inception.jpg grand.jpg mapa.svg darkknight.jpg navio.svg godfather.jpg parasite.jpg matrix.jpg interstellar.jpg whiplash.jpg dune.jpg spirited.jpg].to_h { |name| [name, asset_path("rubens/#{name}")] } %>
  <body class="rubens-frontend" data-controller="rubens-frontend"
        data-action="turbo:before-cache@document->rubens-frontend#cleanup"
        data-rubens-frontend-assets-value="<%= assets.to_json %>"
        data-rubens-frontend-movies-url-value="<%= movies_path %>">
    <%= render "rubens/shared/header" %>
    <p class="integration-notice">Demonstração do front-end: filmes, perfil e interações locais. Dados ainda não conectados à conta do Rails.</p>
    <% flash.each do |type, message| %>
      <div class="container flash" role="<%= type == "alert" ? "alert" : "status" %>"><%= message %></div>
    <% end %>
    <%= yield %>
    <%= render "rubens/shared/footer" %>
  </body>
</html>
