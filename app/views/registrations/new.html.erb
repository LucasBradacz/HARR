<% content_for :title, "Cadastro | HARR" %><main class="container page-content" id="conteudo"><div class="auth-card"><p class="eyebrow">ENTRE PARA A TRIPULAÇÃO</p><h1>Criar conta</h1><div class="form-card"><% if @user.errors.any? %><ul class="error-list"><% @user.errors.full_messages.each do |msg| %><li><%= msg %></li><% end %></ul><% end %><%= form_with model: @user, url: registration_path, local: true, class: "stacked" do |f| %><%= f.label :username, "Usuário" %><%= f.text_field :username %><%= f.label :email, "E-mail" %><%= f.email_field :email %><%= f.label :password, "Senha" %><%= f.password_field :password %><%= f.label :password_confirmation, "Confirmar senha" %><%= f.password_field :password_confirmation %><%= f.submit "Cadastrar", class: "button" %><% end %></div></div></main>
