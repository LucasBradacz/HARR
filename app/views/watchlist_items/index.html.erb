<% content_for :title, "Minha watchlist | HARR" %>
<main class="container page-content" id="conteudo">
  <div class="page-heading"><p class="eyebrow">SUA COLEÇÃO</p><h1>Quero assistir</h1><p>Filmes salvos para assistir depois.</p></div>
  <section class="section">
    <% if @watchlist_items.any? %><div class="movies-grid"><% @watchlist_items.each do |item| %><%= link_to movie_path(item.movie), class: "movie-link movie-card" do %><span class="poster-wrapper"><%= image_tag item.movie.poster_url, alt: item.movie.title, loading: "lazy" if item.movie.poster_url.present? %></span><span class="movie-title"><%= item.movie.title %></span><span class="movie-meta"><%= item.movie.release_year %></span><% end %><% end %></div><% else %><p class="empty-state">Nenhum filme salvo ainda.</p><% end %>
  </section>
</main>
